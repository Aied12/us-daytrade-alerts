# انسخ هذا الملف إلى .env وعبّي القيم
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 89 مستخدمون إضافيون (chat ids مفصولة بفاصلة)
TELEGRAM_EXTRA_CHAT_IDS=

# قناة عامة اختيارية
TELEGRAM_CHANNEL_ID=

# إيقاف تيليجرام مؤقت: 0=واقف / 1=شغال (أو أنشئ ملف data/telegram_paused)
TELEGRAM_ENABLED=1

# رأس المال بالريال
CAPITAL_SAR=45000
USD_SAR_RATE=3.75
RISK_PER_TRADE=0.01
DAILY_LOSS_LIMIT=0.02
MAX_ALERTS_PER_DAY=5
MIN_PRICE_USD=5
URGENT_MIN_SCORE=5
USER_MODE=beginner

# 93 منطقة زمنية
TIMEZONE=Asia/Riyadh

# 85/95 توفير طلبات + نسخة خفيفة
API_THRIFT=0
LIGHT_MODE=0
PRICE_CACHE_TTL=45

# أسعار شبه لحظية (موصى به — Yahoo لوحده ≈15 دقيقة تأخير)
# سجل مجاناً: https://finnhub.io/register ثم الصق المفتاح
FINNHUB_API_KEY=
# بديل: Alpaca (IEX شبه لحظي) https://alpaca.markets
ALPACA_API_KEY=
ALPACA_API_SECRET=

# 90 توكن لوحة الويب (اختياري لكن مستحسن)
DASHBOARD_TOKEN=change-me
